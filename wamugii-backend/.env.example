PROJECT_NAME=WAMUGII TECH SOLUTIONS API

# For Docker (compose), the host is the db service name:
DATABASE_URL=postgresql+psycopg2://wamugii:wamugii@db:5432/wamugii
# If you run WITHOUT Docker, use localhost instead:
# DATABASE_URL=postgresql+psycopg2://wamugii:wamugii@localhost:5432/wamugii

# Generate a strong key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FIRST_ADMIN_EMAIL=admin@wamugii.rw
FIRST_ADMIN_PASSWORD=changeme123

BACKEND_CORS_ORIGINS=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Brevo transactional email. Optional: leave blank and email sending is
# skipped with a warning (in-app notifications still work as normal).
# BREVO_FROM_EMAIL must be a sender address verified in your Brevo account.
BREVO_API_KEY=your-brevo-api-key-here
BREVO_FROM_EMAIL=noreply@yourdomain.com

# Public frontend URL, used for the call-to-action links in emails.
# Leave unset and emails go out without a CTA button.
FRONTEND_URL=https://yourdomain.com
